<!doctype html>
<% const _v = typeof assetV !== 'undefined' ? assetV : ''; %>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? (title.includes('Brand Store') ? title : title + ' — Brand Store') : 'Brand Store' %></title>
  <meta name="description" content="Покупки в магазинах Португалии с доставкой в Россию: Zara, Mango, Massimo Dutti, Sephora и ещё 200+ магазинов. Цена в рублях сразу.">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#3B2418">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/onest-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css?v=<%= _v %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= _v %>">
  <% if (typeof admin !== 'undefined' && admin) { %><link rel="stylesheet" href="/css/admin.css?v=<%= _v %>"><% } %>
  <script src="/js/app.js?v=<%= _v %>" defer></script>
</head>
<body>
