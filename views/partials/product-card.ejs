<% const p = locals.p; %>
<article class="card">
  <div class="card__media">
    <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"><% } %>
    <% if (p.discount) { %><span class="card__badge">−<%= p.discount %>%</span><% } %>
    <% if (p.is_demo) { %><span class="card__demo">пример</span><% } %>
    <button class="card__fav" type="button" data-fav="<%= p.id %>" aria-pressed="<%= favIds.has(p.id) ? 'true' : 'false' %>" aria-label="В избранное"><%- icon('heart') %></button>
  </div>
  <div class="card__body">
    <div class="price">
      <span class="price__now <%= p.discount ? 'is-sale' : '' %>"><%= fmt.rub(p.price_rub) %></span>
      <% if (p.old_rub) { %><span class="price__old"><%= fmt.rub(p.old_rub) %></span><% } %>
    </div>
    <span class="card__brand"><%= p.store_name || 'Brand Store' %></span>
    <a class="card__title card__link" href="/product/<%= p.id %>"><%= p.title %></a>
  </div>
</article>
