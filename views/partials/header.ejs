<%- include('head') %>
<%
  const _g = path === '/' ? (query.g || '') : (path === '/catalog' ? (query.gender || '') : '');
%>
<div class="topbar">
  <div class="wrap">
    <span>Ваши любимые бренды с доставкой до двери</span>
    <nav class="topbar__links" aria-label="Сервис">
      <a href="/order-link">Заказ по ссылке</a>
      <a href="/how-it-works">Как это работает</a>
      <% if (shop.telegram) { %><a href="<%= shop.telegram.startsWith('http') ? shop.telegram : 'https://t.me/' + shop.telegram.replace('@','') %>" target="_blank" rel="noopener">Telegram</a><% } %>
      <% if (shop.phone) { %><a href="tel:<%= shop.phone.replace(/[^+\d]/g, '') %>"><%= shop.phone %></a><% } %>
      <% if (user && user.role === 'admin') { %><a href="/admin">Админка</a><% } %>
    </nav>
  </div>
</div>
<header class="header" id="header">
  <div class="wrap">
    <div class="header__main">
      <nav class="genders" aria-label="Разделы">
        <% Object.entries(fmt.HOME_TABS).forEach(([k, label]) => { %>
          <a href="/?g=<%= k %>" class="<%= _g === k ? 'is-active' : '' %>"<%- _g === k ? ' aria-current="page"' : '' %>><%= label %></a>
        <% }) %>
      </nav>
      <a href="/" class="logo" aria-label="Brand Store — на главную">brand <span class="logo__store">store</span><i class="logo__dot"></i></a>
      <div class="header__right">
        <form class="search" action="/catalog" method="get" role="search">
          <label class="visually-hidden" for="q">Поиск</label>
          <input id="q" name="q" type="search" placeholder="Бренд или товар" value="<%= query.q || '' %>" autocomplete="off">
          <button type="submit" aria-label="Найти"><%- icon('search') %></button>
        </form>
        <div class="actions">
          <a class="action" href="<%= user ? '/account' : '/login' %>"><%- icon('user') %><span><%= user ? (user.name ? user.name.split(' ')[0] : 'Профиль') : 'Войти' %></span></a>
          <a class="action" href="/favorites"><%- icon('heart') %><span>Избранное</span></a>
          <a class="action" href="/cart"><%- icon('bag') %><span>Корзина</span><span class="badge-count" data-cart-count data-count="<%= cartCount %>"><%= cartCount || '' %></span></a>
        </div>
      </div>
    </div>
  </div>
</header>
<main>
  <% if (flash) { %>
    <div class="wrap"><div class="flash flash--<%= flash.type %>" role="status"><%= flash.text %></div></div>
  <% } %>
