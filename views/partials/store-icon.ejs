<% const _s = locals.s; const _size = locals.size || ''; %>
<span class="store-icon <%= _size ? 'store-icon--' + _size : '' %> <%= _s && _s.logo_path ? 'store-icon--logo' : '' %>" data-store-icon data-domain="<%= _s ? _s.icon_domain : '' %>">
<%
  const _name = _s ? String(_s.name || '').replace(/^[&\s]+/, '') : '?';
  const _words = _name.split(/[\s&'’.-]+/).filter(Boolean);
  const _mono = (_words.length > 1 ? _words[0][0] + _words[1][0] : _name.slice(0, 2)).toUpperCase();
  let _h = 0; for (const ch of _name) _h = (_h * 31 + ch.charCodeAt(0)) % 997;
%>
  <span class="store-icon__mono" data-tone="<%= _h % 4 %>" aria-hidden="true"><%= _mono %></span>
  <% if (_s && _s.icon_domain || _s && _s.logo_path) { %><img src="<%= storeIcon(_s) %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %>
</span>
