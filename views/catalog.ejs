<%- include('partials/header') %>
<div class="wrap page">
  <nav class="crumbs"><a href="/">Главная</a><span>/</span><span><%= heading %></span></nav>
  <h1 class="page-title"><%= heading %></h1>
  <p class="page-sub"><%= products.length %> <%= fmt.plural(products.length, 'товар', 'товара', 'товаров') %> на витрине. Не нашли нужное — закажите любую вещь <a class="link" href="/order-link">по ссылке</a>.</p>

  <% if (matchedStores.length) { %>
    <div class="section__head" style="margin-top:8px"><h2 class="section__title" style="font-size:18px">Магазины</h2></div>
    <div class="stores-grid" style="margin-bottom:32px">
      <% matchedStores.forEach((s) => { %>
        <a class="store-card" href="/stores/<%= s.slug %>"><%- include('partials/store-icon', { s }) %><span class="store-card__body"><span class="store-card__name"><%= s.name %></span></span><span class="region region--<%= s.region %>"><%= s.region %></span></a>
      <% }) %>
    </div>
  <% } %>

  <div class="catalog">
    <aside class="filters" aria-label="Фильтры">
      <% const qs = (patch) => { const o = Object.assign({}, query, patch); Object.keys(o).forEach((k) => { if (!o[k]) delete o[k]; }); const s = new URLSearchParams(o).toString(); return '/catalog' + (s ? '?' + s : ''); }; %>
      <div class="filters__group">
        <p class="filters__title">Раздел</p>
        <a href="<%= qs({ gender: '' }) %>" class="<%= !query.gender ? 'is-active' : '' %>">Все</a>
        <% ['women', 'men'].forEach((k) => { const label = GENDERS[k]; %>
          <a href="<%= qs({ gender: k }) %>" class="<%= query.gender === k ? 'is-active' : '' %>"><%= label %></a>
        <% }) %>
      </div>
      <div class="filters__group">
        <p class="filters__title">Категория</p>
        <a href="<%= qs({ cat: '' }) %>" class="<%= !query.cat ? 'is-active' : '' %>">Все категории</a>
        <% ['clothes','shoes','accessories','beauty','home','jewelry','sport','kids'].forEach((k) => { %>
          <a href="<%= qs({ cat: k, sub: '' }) %>" class="<%= query.cat === k ? 'is-active' : '' %>"><%= CATEGORIES[k] %></a>
        <% }) %>
      </div>
      <% if (query.cat === 'beauty') { %>
      <div class="filters__group">
        <p class="filters__title">Красота</p>
        <a href="<%= qs({ sub: '' }) %>" class="<%= !query.sub ? 'is-active' : '' %>">Вся красота</a>
        <% Object.entries(BEAUTY_SUBCATS).forEach(([k, label]) => { %>
          <a href="<%= qs({ sub: k }) %>" class="<%= query.sub === k ? 'is-active' : '' %>"><%= label %></a>
        <% }) %>
      </div>
      <% } %>
      <% if (storesWithProducts.length) { %>
      <div class="filters__group">
        <p class="filters__title">Магазин</p>
        <a href="<%= qs({ store: '' }) %>" class="<%= !query.store ? 'is-active' : '' %>">Все магазины</a>
        <% storesWithProducts.forEach((s) => { %>
          <a href="<%= qs({ store: s.slug }) %>" class="<%= query.store === s.slug ? 'is-active' : '' %>"><%= s.name %></a>
        <% }) %>
      </div>
      <% } %>
    </aside>

    <div>
      <div class="toolbar">
        <div class="chips">
          <a class="chip <%= query.sale === '1' ? 'is-active' : '' %>" href="<%= qs({ sale: query.sale === '1' ? '' : '1' }) %>">Со скидкой</a>
        </div>
        <form method="get" action="/catalog" data-autosubmit>
          <% Object.entries(query).forEach(([k, v]) => { if (k !== 'sort') { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } }) %>
          <label class="visually-hidden" for="sort">Сортировка</label>
          <select class="select" id="sort" name="sort">
            <option value="">Сначала популярные</option>
            <option value="new" <%= query.sort === 'new' ? 'selected' : '' %>>Сначала новые</option>
            <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Сначала дешевле</option>
            <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Сначала дороже</option>
            <option value="discount" <%= query.sort === 'discount' ? 'selected' : '' %>>По размеру скидки</option>
          </select>
        </form>
      </div>
      <% if (products.length) { %>
        <div class="products products--4">
          <% products.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
        </div>
      <% } else { %>
        <div class="empty-hint">
          <p style="margin:0 0 14px">Здесь пока нет товаров. Найдите вещь на сайте магазина и закажите по ссылке — это работает для любого товара.</p>
          <a class="btn" href="/order-link">Заказать по ссылке</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
