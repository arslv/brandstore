<%- include('../partials/header') %>
<div class="wrap page">
  <div class="auth">
    <h1 class="page-title">Регистрация</h1>
    <p class="page-sub">Займёт минуту. Корзина сохранится.</p>
    <form class="panel" method="post" action="/register" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name">Имя</label>
        <input class="input <%= errors.name ? 'is-invalid' : '' %>" id="name" name="name" value="<%= values.name || '' %>" autocomplete="name" required autofocus>
        <% if (errors.name) { %><span class="field__error"><%= errors.name %></span><% } %>
      </div>
      <div class="field">
        <label for="email">Почта</label>
        <input class="input <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" required>
        <% if (errors.email) { %><span class="field__error"><%= errors.email %></span><% } %>
      </div>
      <div class="field">
        <label for="phone">Телефон <span class="muted">— необязательно</span></label>
        <input class="input" id="phone" name="phone" type="tel" value="<%= values.phone || '' %>" autocomplete="tel" placeholder="+7 900 000-00-00">
      </div>
      <div class="field">
        <label for="password">Пароль</label>
        <input class="input <%= errors.password ? 'is-invalid' : '' %>" id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
        <span class="field__hint">Не короче 8 символов.</span>
        <% if (errors.password) { %><span class="field__error"><%= errors.password %></span><% } %>
      </div>
      <label class="checkbox" style="margin-bottom:16px"><input type="checkbox" name="agree" value="1"><span>Согласен на обработку персональных данных</span></label>
      <% if (errors.agree) { %><p class="field__error" style="margin:-8px 0 16px"><%= errors.agree %></p><% } %>
      <button class="btn btn--block" type="submit">Создать аккаунт</button>
    </form>
    <p class="auth__switch">Уже есть аккаунт? <a class="link" href="/login">Войдите</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
