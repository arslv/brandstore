<%- include('partials/header') %>
<div class="wrap page">
  <nav class="crumbs"><a href="/">Главная</a><span>/</span><span>Заказ по ссылке</span></nav>
  <h1 class="page-title">Заказ по ссылке</h1>

  <form class="link-order" method="post" action="/cart/add-link?_csrf=<%= csrfToken %>" enctype="multipart/form-data" data-link-form data-rate="<%= quote.rate %>" data-markup="<%= quote.markup %>">
    <div class="panel">
      <div class="field">
        <label for="url">Ссылка на товар</label>
        <div class="paste__field">
          <input class="input" id="url" name="url" type="url" inputmode="url" required placeholder="https://www.zara.com/pt/…" value="<%= prefillUrl %>" data-url style="padding-right:48px">
          <span class="paste__ok" data-detect-ok hidden title="Магазин из списка"><%- icon('check') %></span>
        </div>
        <div class="detect" data-detect>
          <span data-detect-icon></span>
          <span class="detect__text" data-detect-text></span>
        </div>
        <div class="parse" data-parse hidden aria-live="polite">
          <div class="parse__loading" data-parse-loading><span class="spinner" aria-hidden="true"></span>Смотрим цену на сайте магазина…</div>
          <div class="parse__card" data-parse-card hidden>
            <img class="parse__img" data-parse-img alt="">
            <div class="parse__body">
              <div class="parse__title" data-parse-title></div>
              <div class="parse__price"><b data-parse-rub></b> <span class="muted" data-parse-eur></span></div>
              <div class="parse__note small muted" data-parse-note></div>
            </div>
          </div>
          <div class="parse__fail small" data-parse-fail hidden></div>
        </div>
        <input type="hidden" name="image_url" data-image-url>
        <input type="hidden" name="parsed_price" data-parsed-price>
      </div>

      <div class="row">
        <div class="field">
          <label for="store_id">Магазин</label>
          <select class="select" id="store_id" name="store_id" data-store-select>
            <option value="">Определится по ссылке</option>
            <% stores.forEach((s) => { %><option value="<%= s.id %>" data-url="<%= s.url %>" <%= preset && preset.id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="title">Название товара <span class="muted">— необязательно</span></label>
          <input class="input" id="title" name="title" maxlength="200" placeholder="Например, тренч из хлопка" data-title>
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="price_eur">Цена на сайте, €</label>
          <input class="input" id="price_eur" name="price_eur" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="49,99" data-price>
        </div>
        <div class="field">
          <label for="qty">Количество</label>
          <input class="input" id="qty" name="qty" type="number" min="1" max="20" value="1" required data-qty>
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="size">Размер</label>
          <input class="input" id="size" name="size" maxlength="60" required placeholder="M, 38, 50 мл…" data-size>
          <div class="chips" style="margin-top:4px" data-size-chips></div>
          <div class="chips" style="margin-top:4px" data-size-default>
            <button type="button" class="chip" data-fill="size" data-value="Без размера">Без размера</button>
            <button type="button" class="chip" data-fill="size" data-value="Один размер">Один размер</button>
          </div>
        </div>
        <div class="field">
          <label for="color">Цвет</label>
          <input class="input" id="color" name="color" maxlength="60" required placeholder="Как назван на сайте: Preto, Bege…" data-color>
          <div class="chips" style="margin-top:4px" data-color-chips></div>
        </div>
      </div>

      <div class="field">
        <label for="photo">Фото или скриншот товара <span class="muted">— необязательно, но так менеджер не ошибётся</span></label>
        <input class="input" id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp">
      </div>

      <div class="field">
        <label for="comment">Комментарий <span class="muted">— необязательно</span></label>
        <textarea class="textarea" id="comment" name="comment" maxlength="500" placeholder="Например: если нет M, возьмите L"></textarea>
      </div>
    </div>

    <aside class="panel panel--dark summary">
      <p class="small" style="margin:0;opacity:.75">Цена в рублях</p>
      <p class="summary-price" data-sum>—</p>
      <p class="small" style="opacity:.75;margin:0 0 20px" data-sum-note>без доставки</p>
      <button class="btn btn--light btn--block" type="submit" name="next" value="cart">Добавить в корзину</button>
      <button class="btn btn--ghost btn--block" type="submit" name="next" value="more" style="margin-top:8px;color:var(--bg);border-color:rgba(255, 255, 255,.4)">Добавить и выбрать ещё</button>
    </aside>
  </form>
</div>
<%- include('partials/footer') %>
