<%- include('partials/header') %>
<div class="wrap page">
  <nav class="crumbs"><a href="/cart">Корзина</a><span>/</span><span>Оформление</span></nav>
  <h1 class="page-title">Оформление заказа</h1>
  <p class="page-sub"><%= payFlow === 'instant' ? 'Укажите получателя и способ оплаты.' : 'Оплата — после проверки наличия. Мы пришлём письмо, когда заказ можно будет оплатить.' %></p>
  <form class="cart" method="post" action="/checkout" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel">
      <p class="panel__title">Получатель</p>
      <div class="row">
        <div class="field">
          <label for="name">Имя и фамилия</label>
          <input class="input <%= errors.name ? 'is-invalid' : '' %>" id="name" name="name" value="<%= values.name %>" autocomplete="name" required>
          <% if (errors.name) { %><span class="field__error"><%= errors.name %></span><% } %>
        </div>
        <div class="field">
          <label for="phone">Телефон</label>
          <input class="input <%= errors.phone ? 'is-invalid' : '' %>" id="phone" name="phone" type="tel" value="<%= values.phone %>" autocomplete="tel" placeholder="+7 900 000-00-00" required>
          <% if (errors.phone) { %><span class="field__error"><%= errors.phone %></span><% } %>
        </div>
      </div>
      <div class="field">
        <label for="email">Почта</label>
        <input class="input <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" type="email" value="<%= values.email %>" autocomplete="email" required>
        <span class="field__hint">Сюда придут ссылка на оплату и трек-номер.</span>
        <% if (errors.email) { %><span class="field__error"><%= errors.email %></span><% } %>
      </div>

      <p class="panel__title" style="margin-top:12px">Доставка</p>
      <div class="radio-cards">
        <% Object.entries(DELIVERY_METHODS).forEach(([k, label]) => { %>
          <label class="radio-card"><input type="radio" name="delivery" value="<%= k %>" <%= values.delivery === k ? 'checked' : '' %>><span><b><%= label %></b><br><span class="muted small"><%= k === 'pickup' ? 'СДЭК, Boxberry или Почта' : 'По городу получателя' %></span></span></label>
        <% }) %>
      </div>
      <div class="row">
        <div class="field">
          <label for="city">Город</label>
          <input class="input <%= errors.city ? 'is-invalid' : '' %>" id="city" name="city" value="<%= values.city %>" autocomplete="address-level2" required>
          <% if (errors.city) { %><span class="field__error"><%= errors.city %></span><% } %>
        </div>
        <div class="field">
          <label for="address">Адрес или пункт выдачи</label>
          <input class="input <%= errors.address ? 'is-invalid' : '' %>" id="address" name="address" value="<%= values.address %>" autocomplete="street-address" required>
          <% if (errors.address) { %><span class="field__error"><%= errors.address %></span><% } %>
        </div>
      </div>
      <div class="field">
        <label for="comment">Комментарий к заказу <span class="muted">— необязательно</span></label>
        <textarea class="textarea" id="comment" name="comment" maxlength="1000"><%= values.comment %></textarea>
      </div>
      <p class="panel__title" style="margin-top:12px">Оплата</p>
      <% if (payFlow === 'instant') { %>
        <% if (payMode === 'demo') { %><div class="test-banner"><%- icon('alert') %><span>Тестовый режим оплаты: деньги не списываются.</span></div><% } %>
        <div class="methods" role="radiogroup" aria-label="Способ оплаты" style="margin-bottom:16px">
          <% methods.forEach((m) => { %>
            <label class="method">
              <input type="radio" name="method" value="<%= m.key %>" <%= values.method === m.key ? 'checked' : '' %>>
              <span class="method__icon"><%- icon(m.icon) %></span>
              <span><b><%= m.label %></b><span class="muted"><%= m.hint %></span></span>
            </label>
          <% }) %>
        </div>
        <% if (errors.method) { %><p class="field__error" style="margin:-8px 0 16px"><%= errors.method %></p><% } %>
      <% } else { %>
        <p class="muted small" style="margin:-6px 0 12px">Сначала проверим наличие и цены в магазинах, потом пришлём письмо — оплатить можно будет в личном кабинете.</p>
        <div class="method-badges" style="margin-bottom:20px">
          <% methods.forEach((m) => { %><span class="method-badge"><%- icon(m.icon) %><%= m.label %></span><% }) %>
        </div>
      <% } %>
      <label class="checkbox"><input type="checkbox" name="agree" value="1" required><span>Согласен с условиями сервиса и обработкой персональных данных</span></label>
      <% if (errors.agree) { %><span class="field__error"><%= errors.agree %></span><% } %>
    </div>

    <aside class="panel summary">
      <p class="panel__title">Ваш заказ</p>
      <% cart.items.forEach((it) => { %>
        <div class="summary__row small"><span><%= it.store_name ? it.store_name + ' · ' : '' %><%= it.title %> <span class="muted">× <%= it.qty %></span></span><span class="nowrap"><%= fmt.rub(it.line_rub) %></span></div>
      <% }) %>
      <div class="summary__row" style="border-top:1px solid var(--line);margin-top:8px;padding-top:12px"><span>Товары</span><span><%= fmt.rub(cart.subtotal) %></span></div>
      <div class="summary__row"><span>Доставка</span><span><%= cart.delivery ? fmt.rub(cart.delivery) : 'посчитает менеджер' %></span></div>
      <div class="summary__row summary__total"><span>Итого</span><span><%= fmt.rub(cart.total) %></span></div>
      <button class="btn btn--block" type="submit"><%= payFlow === 'instant' ? 'Оформить и оплатить' : 'Оформить заказ' %></button>
      <p class="muted small" style="margin:14px 0 0"><%= payFlow === 'instant' ? 'Сразу после оформления откроется оплата выбранным способом.' : 'После оформления мы проверим наличие и пришлём письмо на ' + (values.email || 'вашу почту') + '.' %></p>
    </aside>
  </form>
</div>
<%- include('partials/footer') %>
