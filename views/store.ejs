<%- include('partials/header') %>
<div class="wrap page">
  <nav class="crumbs"><a href="/">Главная</a><span>/</span><a href="/stores">Бренды</a><span>/</span><span><%= store.name %></span></nav>

  <div class="store-page">
    <div>
      <div class="store-page__head">
        <%- include('partials/store-icon', { s: store, size: 'lg' }) %>
        <div>
          <h1 class="page-title" style="margin:0"><%= store.name %></h1>
          <p class="muted" style="margin:6px 0 0"><%= (subcats.length ? subcats.map((c) => BEAUTY_SUBCATS[c]) : cats.map((c) => CATEGORIES[c])).filter(Boolean).join(' · ') %></p>
        </div>
      </div>
      <% if (store.note) { %><p class="store-page__note"><%= store.note %></p><% } %>
      <a class="btn" href="<%= store.url %>" target="_blank" rel="noopener nofollow"><%- icon('external') %> Открыть сайт <%= store.name %></a>
    </div>
    <%- include('partials/paste-form', { quote, pasteStore: store }) %>
  </div>

  <% if (products.length) { %>
  <section class="section">
    <div class="section__head"><h2 class="section__title">Товары <%= store.name %></h2></div>
    <div class="products">
      <% products.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  </section>
  <% } %>
</div>
<%- include('partials/footer') %>
