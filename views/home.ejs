<%- include('partials/header') %>
<section class="brand-wall" aria-labelledby="home-title">
  <h1 class="visually-hidden" id="home-title"><%= heading %></h1>
  <% if (brands.length) { %>
    <div class="brand-grid" data-brand-grid>
      <% brands.forEach((s) => { %>
        <a class="brand-tile" href="/stores/<%= s.slug %>" style="<%= fmt.tileStyle(s) %>" data-font="<%= s.tile_font %>" aria-label="<%= s.name %>">
          <span class="brand-tile__name" data-fit><%= s.tile_text || s.name %></span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">Скоро здесь появятся бренды. А пока посмотрите <a class="link" href="/stores">все магазины</a>.</p>
  <% } %>
  <div class="home-more"><a class="btn" href="<%= moreUrl %>">Ещё бренды <%- icon('arrow') %></a></div>
</section>

<div class="wrap">
  <section class="home-section">
    <form class="paste" method="post" action="/cart/add-link" novalidate data-link-form data-paste data-rate="<%= quote.rate %>" data-markup="<%= quote.markup %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="cart">
      <input type="hidden" name="title" data-title>
      <input type="hidden" name="image_url" data-image-url>
      <input type="hidden" name="parsed_price" data-parsed-price>

      <h2 class="section__title">Вставьте ссылку на товар</h2>
      <p class="paste__sub">Откройте товар на сайте магазина из нашего списка и скопируйте ссылку — цену, фото и размеры подтянем сами.</p>

      <div class="paste__bar">
        <label class="visually-hidden" for="paste-url">Ссылка на товар</label>
        <input class="input paste__input" id="paste-url" name="url" type="url" inputmode="url" autocomplete="off" placeholder="https://www.zara.com/pt/pt/…" data-url>
        <button class="btn paste__btn" type="submit" data-submit><%- icon('bag') %>Добавить в корзину</button>
      </div>

      <div class="detect" data-detect>
        <span data-detect-icon></span>
        <span class="detect__text" data-detect-text></span>
      </div>
      <div class="parse" data-parse hidden aria-live="polite">
        <div class="parse__loading" data-parse-loading><span class="spinner" aria-hidden="true"></span>Смотрим цену на сайте магазина…</div>
        <div class="parse__card" data-parse-card hidden>
          <img class="parse__img" data-parse-img alt="">
          <div class="parse__body">
            <div class="parse__title" data-parse-title></div>
            <div class="parse__price"><b data-parse-rub></b> <span class="muted" data-parse-eur></span></div>
            <div class="parse__note small muted" data-parse-note></div>
          </div>
        </div>
        <div class="parse__fail small" data-parse-fail hidden></div>
      </div>

      <div class="paste__details" data-details hidden>
        <div class="row">
          <div class="field">
            <label for="paste-size">Размер</label>
            <input class="input" id="paste-size" name="size" maxlength="60" placeholder="M, 38, 50 мл…" data-size>
            <div class="chips" data-size-chips></div>
            <div class="chips" data-size-default>
              <button type="button" class="chip" data-fill="size" data-value="Без размера">Без размера</button>
              <button type="button" class="chip" data-fill="size" data-value="Один размер">Один размер</button>
            </div>
          </div>
          <div class="field">
            <label for="paste-color">Цвет</label>
            <input class="input" id="paste-color" name="color" maxlength="60" placeholder="Как назван на сайте: Preto, Bege…" data-color>
            <div class="chips" data-color-chips></div>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="paste-price">Цена на сайте, €</label>
            <input class="input" id="paste-price" name="price_eur" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="49,99" data-price>
            <span class="field__hint">Цену со скидкой указывайте ту, что видите сейчас.</span>
          </div>
          <div class="field">
            <label for="paste-qty">Количество</label>
            <input class="input" id="paste-qty" name="qty" type="number" min="1" max="20" value="1" data-qty>
            <span class="field__hint">В рублях: <b class="paste__sum" data-sum>—</b>, без доставки в Россию</span>
          </div>
        </div>
        <p class="small muted paste__more">Нужно приложить фото или оставить комментарий менеджеру? <a class="link" href="/order-link" data-full-form>Откройте полную форму</a>.</p>
      </div>
      <p class="field__error paste__error" data-form-error role="alert"></p>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
