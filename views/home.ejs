<%- include('partials/header') %>
<section class="brand-wall" aria-labelledby="home-title">
  <h1 class="visually-hidden" id="home-title"><%= heading %></h1>
  <% if (brands.length) { %>
    <div class="brand-grid is-collapsed" data-brand-grid>
      <% brands.forEach((s) => { %>
        <a class="brand-tile" href="/stores/<%= s.slug %>" style="<%= fmt.tileStyle(s) %>" data-font="<%= s.tile_font %>" aria-label="<%= s.name %>">
          <span class="brand-tile__name" data-fit><%= s.tile_text || s.name %></span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">Скоро здесь появятся бренды.</p>
  <% } %>
  <div class="home-more"><a class="btn" href="<%= moreUrl %>" data-brands-more><span data-label>Ещё бренды</span> <%- icon('arrow') %></a></div>
</section>

<div class="wrap">
  <section class="home-section">
    <%- include('partials/paste-form', { quote }) %>
  </section>
</div>
<%- include('partials/footer') %>
