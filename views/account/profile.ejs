<%- include('../partials/header') %>
<div class="wrap page">
  <div class="account">
    <%- include('_nav') %>
    <div style="max-width:640px">
      <h1 class="page-title">Профиль</h1>
      <p class="page-sub"><%= user.email %></p>
      <form class="panel" method="post" action="/account/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <div class="field"><label for="name">Имя и фамилия</label><input class="input" id="name" name="name" value="<%= values.name %>" autocomplete="name"></div>
          <div class="field"><label for="phone">Телефон</label><input class="input" id="phone" name="phone" type="tel" value="<%= values.phone %>" autocomplete="tel"></div>
        </div>
        <div class="row">
          <div class="field"><label for="city">Город</label><input class="input" id="city" name="city" value="<%= values.city %>"></div>
          <div class="field"><label for="address">Адрес или пункт выдачи</label><input class="input" id="address" name="address" value="<%= values.address %>"></div>
        </div>
        <button class="btn" type="submit">Сохранить</button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
