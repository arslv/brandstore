<%- include('_header') %>
<% let imgs = []; try { imgs = JSON.parse(product.images || '[]'); } catch (e) {} %>
<div class="admin__head">
  <div>
    <div class="crumbs" style="margin:0 0 6px"><a href="/admin/products">Товары</a><span>/</span><span><%= product.id ? 'Редактирование' : 'Новый' %></span></div>
    <h1><%= product.id ? product.title : 'Новый товар' %></h1>
  </div>
  <% if (product.id) { %><a class="btn btn--sm btn--ghost" href="/product/<%= product.id %>" target="_blank" rel="noopener">Открыть на сайте</a><% } %>
</div>

<form class="grid-2" method="post" action="<%= product.id ? '/admin/products/' + product.id : '/admin/products' %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
  <div class="panel">
    <div class="field">
      <label for="title">Название</label>
      <input class="input <%= errors.title ? 'is-invalid' : '' %>" id="title" name="title" value="<%= product.title || '' %>" required>
      <% if (errors.title) { %><span class="field__error"><%= errors.title %></span><% } %>
    </div>
    <div class="row">
      <div class="field">
        <label for="store_id">Магазин</label>
        <select class="select" id="store_id" name="store_id">
          <option value="">—</option>
          <% stores.forEach((s) => { %><option value="<%= s.id %>" <%= product.store_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="source_url">Ссылка на товар в магазине</label>
        <input class="input" id="source_url" name="source_url" type="url" value="<%= product.source_url || '' %>" placeholder="https://…">
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="category">Категория</label>
        <select class="select" id="category" name="category">
          <% Object.entries(CATEGORIES).forEach(([k, label]) => { %><option value="<%= k %>" <%= product.category === k ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="subcategory">Подкатегория красоты</label>
        <select class="select" id="subcategory" name="subcategory">
          <option value="">—</option>
          <% Object.entries(BEAUTY_SUBCATS).forEach(([k, label]) => { %><option value="<%= k %>" <%= product.subcategory === k ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
        <span class="field__hint">Только для категории «Красота».</span>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="gender">Раздел</label>
        <select class="select" id="gender" name="gender">
          <% Object.entries(GENDERS).forEach(([k, label]) => { %><option value="<%= k %>" <%= product.gender === k ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="price_eur">Цена, €</label>
        <input class="input <%= errors.price_eur ? 'is-invalid' : '' %>" id="price_eur" name="price_eur" type="number" min="0" step="0.01" value="<%= product.price_eur || '' %>" required>
        <% if (errors.price_eur) { %><span class="field__error"><%= errors.price_eur %></span><% } %>
      </div>
      <div class="field">
        <label for="old_price_eur">Старая цена, € <span class="muted">— для скидки</span></label>
        <input class="input" id="old_price_eur" name="old_price_eur" type="number" min="0" step="0.01" value="<%= product.old_price_eur || '' %>">
      </div>
    </div>
    <div class="field">
      <label for="sizes">Размеры через запятую</label>
      <input class="input" id="sizes" name="sizes" value="<%= product.sizes || '' %>" placeholder="XS, S, M, L">
    </div>
    <div class="field">
      <label for="colors">Цвета через запятую</label>
      <input class="input" id="colors" name="colors" value="<%= product.colors || '' %>" placeholder="Чёрный, Бежевый">
    </div>
    <div class="field">
      <label for="description">Описание</label>
      <textarea class="textarea" id="description" name="description"><%= product.description || '' %></textarea>
    </div>
  </div>

  <div class="stack">
    <div class="panel">
      <p class="panel__title">Фото</p>
      <% if (imgs.length) { %>
        <div class="img-list" style="margin-bottom:14px">
          <% imgs.forEach((img) => { %><label><img src="<%= img %>" alt=""><span><input type="checkbox" name="remove_image" value="<%= img %>"> удалить</span></label><% }) %>
        </div>
      <% } %>
      <div class="field">
        <label for="photos">Загрузить фото</label>
        <input class="input" id="photos" name="photos" type="file" accept="image/*" multiple>
      </div>
      <div class="field" style="margin:0">
        <label for="image_urls">или ссылки на фото, через пробел</label>
        <textarea class="textarea" id="image_urls" name="image_urls" style="min-height:60px" placeholder="https://…"></textarea>
      </div>
    </div>
    <div class="panel">
      <label class="checkbox" style="margin-bottom:10px"><input type="checkbox" name="is_active" value="1" <%= product.is_active ? 'checked' : '' %>><span>Показывать на сайте</span></label>
      <label class="checkbox" style="margin-bottom:16px"><input type="checkbox" name="is_featured" value="1" <%= product.is_featured ? 'checked' : '' %>><span>В блоке «Популярное» на главной</span></label>
      <button class="btn btn--block" type="submit"><%= product.id ? 'Сохранить' : 'Добавить товар' %></button>
    </div>
  </div>
</form>
<% if (product.id) { %>
  <form method="post" action="/admin/products/<%= product.id %>/delete" data-confirm="Удалить товар? Это действие нельзя отменить." style="margin-top:16px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--sm btn--danger" type="submit">Удалить товар</button>
  </form>
<% } %>
<%- include('_footer') %>
