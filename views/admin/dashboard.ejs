<%- include('_header') %>
<div class="admin__head"><h1>Сводка</h1><a class="btn btn--sm" href="/admin/orders?status=new">Новые заказы (<%= byStatus.new || 0 %>)</a></div>

<% if (!mail.smtp) { %>
  <div class="notice notice--warn"><b>Почта не настроена.</b> Письма о заказах сейчас сохраняются в папку <code>data/outbox</code> на сервере. Заполните SMTP в файле <code>.env</code>, чтобы уведомления приходили на <%= mail.notifyTo || 'вашу почту' %>.</div>
<% } %>
<% if (quote.source === 'fallback') { %>
  <div class="notice notice--warn"><b>Курс ЦБ не загрузился.</b> Сейчас цены считаются по ручному курсу <%= quote.rate %> ₽. <a class="link" href="/admin/settings">Проверить настройки</a></div>
<% } %>

<div class="kpis">
  <div class="kpi kpi--dark"><div class="kpi__value"><%= byStatus.new || 0 %></div><div class="kpi__label">ждут проверки</div></div>
  <div class="kpi"><div class="kpi__value"><%= byStatus.awaiting_payment || 0 %></div><div class="kpi__label">ждут оплаты</div></div>
  <div class="kpi"><div class="kpi__value"><%= toBuy %></div><div class="kpi__label"><a class="link" href="/admin/purchases">товаров к выкупу</a></div></div>
  <div class="kpi"><div class="kpi__value"><%= fmt.rub(monthSum) %></div><div class="kpi__label">оплачено за 30 дней</div></div>
</div>

<div class="grid-2">
  <div>
    <h2 style="font-size:18px;margin:0 0 12px">Последние заказы</h2>
    <% if (!recent.length) { %>
      <div class="notice">Заказов пока нет. Когда покупатель оформит заказ, он появится здесь, а на почту придёт уведомление.</div>
    <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Заказ</th><th>Покупатель</th><th>Статус</th><th class="num">Сумма</th></tr></thead>
        <tbody>
          <% recent.forEach((o) => { const st = ORDER_STATUSES[o.status]; %>
            <tr data-href="/admin/orders/<%= o.id %>">
              <td><a href="/admin/orders/<%= o.id %>"><b><%= o.number %></b></a><div class="muted small"><%= fmt.dateTime(o.created_at) %></div></td>
              <td><%= o.customer_name %><div class="muted small"><%= o.phone %></div></td>
              <td><span class="status status--<%= st.tone %>"><%= st.short %></span></td>
              <td class="num"><b><%= fmt.rub(o.total_rub) %></b></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
  <div class="stack">
    <div class="panel">
      <p class="panel__title">Цены</p>
      <dl class="dl">
        <dt>Курс</dt><dd>1 € = <b><%= Number(quote.rate).toFixed(2) %> ₽</b> <span class="muted small">(<%= quote.source === 'cbr' ? 'ЦБ РФ' : quote.source === 'manual' ? 'ручной' : 'ручной, ЦБ недоступен' %>)</span></dd>
        <% if (rateUpdated) { %><dt>Обновлён</dt><dd><%= fmt.dateTime(rateUpdated) %></dd><% } %>
        <dt>Наценка</dt><dd><b><%= quote.markup %>%</b></dd>
        <dt>100 € =</dt><dd><b><%= fmt.rub(pricing.eurToRub(100, quote.rate, quote.markup)) %></b></dd>
      </dl>
      <a class="btn btn--sm btn--ghost" href="/admin/settings" style="margin-top:14px">Изменить</a>
    </div>
    <div class="panel">
      <p class="panel__title">Подключения</p>
      <dl class="dl">
        <dt>Почта</dt><dd><%= mail.smtp ? 'SMTP настроен' : 'не настроена' %><div class="muted small">уведомления → <%= mail.notifyTo || 'адрес не указан' %></div></dd>
        <dt>Оплата</dt><dd><%= yookassaOn ? 'ЮKassa подключена' : 'ссылкой от менеджера' %></dd>
        <dt>Покупатели</dt><dd><%= users %></dd>
      </dl>
    </div>
  </div>
</div>
<%- include('_footer') %>
