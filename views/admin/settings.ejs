<%- include('_header') %>
<div class="admin__head"><h1>Настройки</h1></div>
<div class="grid-2">
  <form class="stack" method="post" action="/admin/settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel">
      <p class="panel__title">Цены</p>
      <div class="row">
        <div class="field">
          <label for="markup_pct">Наценка, %</label>
          <input class="input" id="markup_pct" name="markup_pct" type="number" min="0" max="500" step="0.1" value="<%= s.markup_pct %>">
          <span class="field__hint">Применяется ко всем ценам на сайте сразу после сохранения. В уже оформленных заказах наценка не меняется.</span>
        </div>
        <div class="field">
          <label for="delivery_fee_rub">Доставка в Россию, ₽ за заказ</label>
          <input class="input" id="delivery_fee_rub" name="delivery_fee_rub" type="number" min="0" value="<%= s.delivery_fee_rub %>">
          <span class="field__hint">0 — покупатель увидит «посчитает менеджер».</span>
        </div>
      </div>
      <div class="field">
        <span class="label">Курс евро</span>
        <div class="radio-cards">
          <label class="radio-card"><input type="radio" name="rate_mode" value="auto" <%= s.rate_mode !== 'manual' ? 'checked' : '' %>><span><b>Курс ЦБ РФ</b><br><span class="muted small">Обновляется каждые 6 часов<%= s.rate_eur_auto ? ' · сейчас ' + Number(s.rate_eur_auto).toFixed(2) + ' ₽' : '' %></span></span></label>
          <label class="radio-card"><input type="radio" name="rate_mode" value="manual" <%= s.rate_mode === 'manual' ? 'checked' : '' %>><span><b>Ручной курс</b><br><span class="muted small">Используется и как запасной, если ЦБ недоступен</span></span></label>
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="rate_eur_manual">Ручной курс, ₽ за 1 €</label>
          <input class="input" id="rate_eur_manual" name="rate_eur_manual" type="number" min="1" step="0.01" value="<%= s.rate_eur_manual %>">
        </div>
        <div class="field">
          <label for="eu_limit_eur">Подсвечивать позиции дороже, €</label>
          <input class="input" id="eu_limit_eur" name="eu_limit_eur" type="number" min="0" value="<%= s.eu_limit_eur %>">
          <span class="field__hint">В заказе такие товары помечаются для проверки ограничений ЕС. 0 — не помечать.</span>
        </div>
      </div>
      <p class="muted small" style="margin:0">Сейчас: 1 € = <%= Number(quote.rate).toFixed(2) %> ₽, 100 € на сайте = <b><%= fmt.rub(pricing.eurToRub(100, quote.rate, quote.markup)) %></b></p>
    </div>

    <div class="panel">
      <p class="panel__title">Уведомления и контакты</p>
      <div class="field">
        <label for="notify_email">Почта для уведомлений о новых заказах</label>
        <input class="input" id="notify_email" name="notify_email" type="email" multiple value="<%= s.notify_email %>" placeholder="orders@вашдомен.ru">
        <span class="field__hint">Можно указать несколько адресов через запятую.</span>
      </div>
      <div class="row-3">
        <div class="field"><label for="shop_email">Почта в подвале</label><input class="input" id="shop_email" name="shop_email" value="<%= s.shop_email %>"></div>
        <div class="field"><label for="shop_phone">Телефон</label><input class="input" id="shop_phone" name="shop_phone" value="<%= s.shop_phone %>"></div>
        <div class="field"><label for="shop_telegram">Telegram</label><input class="input" id="shop_telegram" name="shop_telegram" value="<%= s.shop_telegram %>" placeholder="@brandstore"></div>
      </div>
    </div>

    <div class="panel">
      <p class="panel__title">Оплата</p>
      <div class="field">
        <span class="label">Как принимаем оплату</span>
        <div class="radio-cards" style="grid-template-columns:1fr">
          <label class="radio-card"><input type="radio" name="payment_mode" value="demo" <%= payMode === 'demo' ? 'checked' : '' %>><span><b>Тестовая оплата</b><br><span class="muted small">Покупатель выбирает способ, видит тестовую страницу банка, заказ становится «Оплачен». Деньги не списываются.</span></span></label>
          <label class="radio-card"><input type="radio" name="payment_mode" value="link" <%= payMode === 'link' ? 'checked' : '' %>><span><b>Ссылка от менеджера</b><br><span class="muted small">Менеджер вставляет в заказ платёжную ссылку любого банка. Статус «Оплачен» ставится вручную.</span></span></label>
          <label class="radio-card" style="<%= yookassaOn ? '' : 'opacity:.55' %>"><input type="radio" name="payment_mode" value="yookassa" <%= payMode === 'yookassa' ? 'checked' : '' %> <%= yookassaOn ? '' : 'disabled' %>><span><b>ЮKassa</b><br><span class="muted small"><%= yookassaOn ? 'Настоящая оплата, статус «Оплачен» ставится автоматически.' : 'Укажите YOOKASSA_SHOP_ID и YOOKASSA_SECRET_KEY в файле .env и перезапустите сайт.' %></span></span></label>
        </div>
      </div>
      <div class="field">
        <span class="label">Когда покупатель платит</span>
        <div class="radio-cards">
          <label class="radio-card"><input type="radio" name="pay_flow" value="after_check" <%= s.pay_flow !== 'instant' ? 'checked' : '' %>><span><b>После проверки</b><br><span class="muted small">Менеджер проверяет наличие и переводит заказ в «Ожидает оплаты»</span></span></label>
          <label class="radio-card"><input type="radio" name="pay_flow" value="instant" <%= s.pay_flow === 'instant' ? 'checked' : '' %>><span><b>Сразу при оформлении</b><br><span class="muted small">Как в обычном маркетплейсе</span></span></label>
        </div>
      </div>
      <div class="field">
        <span class="label">Способы оплаты на сайте</span>
        <div class="cat-checks">
          <% Object.entries(PAYMENT_METHODS).forEach(([k, m]) => { %>
            <label class="checkbox"><input type="checkbox" name="payment_methods" value="<%= k %>" <%= enabledMethods.includes(k) ? 'checked' : '' %>><span><%= m.label %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="field" style="margin:0">
        <label for="payment_instructions">Текст об оплате для покупателя</label>
        <textarea class="textarea" id="payment_instructions" name="payment_instructions"><%= s.payment_instructions %></textarea>
      </div>
    </div>
    <button class="btn" type="submit">Сохранить настройки</button>
  </form>

  <div class="stack">
    <div class="panel">
      <p class="panel__title">Курс ЦБ</p>
      <p class="muted small" style="margin-top:-8px"><%= s.rate_updated_at ? 'Обновлён ' + fmt.dateTime(s.rate_updated_at) : 'Ещё не загружался' %></p>
      <form method="post" action="/admin/settings/refresh-rate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--ghost" type="submit">Обновить курс сейчас</button></form>
    </div>
    <div class="panel">
      <p class="panel__title">Почта</p>
      <p class="small" style="margin-top:-8px"><%= mail.smtp ? 'SMTP настроен.' : 'SMTP не настроен — письма сохраняются в data/outbox.' %> Уведомления уходят на <b><%= mail.notifyTo || '—' %></b>.</p>
      <form method="post" action="/admin/settings/test-email"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--ghost" type="submit">Отправить тестовое письмо</button></form>
    </div>
    <div class="panel">
      <p class="panel__title">Онлайн-оплата</p>
      <% if (yookassaOn) { %>
        <p class="small" style="margin-top:-8px">ЮKassa подключена. Адрес для уведомлений в личном кабинете ЮKassa:</p>
        <code class="small" style="word-break:break-all"><%= siteUrl %>/webhooks/yookassa</code>
      <% } else { %>
        <p class="small" style="margin-top:-8px">ЮKassa не подключена — работает режим из блока «Оплата». Для настоящей оплаты укажите ключи ЮKassa в файле .env и выберите режим «ЮKassa».</p>
      <% } %>
    </div>
    <% if (demoCount) { %>
    <div class="panel">
      <p class="panel__title">Демо-товары</p>
      <p class="small" style="margin-top:-8px">На витрине <%= demoCount %> примеров товаров. Удалите их, когда добавите свои.</p>
      <form method="post" action="/admin/settings/delete-demo" data-confirm="Удалить все демо-товары?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--danger" type="submit">Удалить демо-товары</button></form>
    </div>
    <% } %>
  </div>
</div>
<%- include('_footer') %>
