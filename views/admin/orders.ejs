<%- include('_header') %>
<div class="admin__head">
  <h1>Заказы</h1>
  <form method="get" action="/admin/orders" style="display:flex;gap:8px">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <input class="input" name="q" value="<%= q %>" placeholder="Номер, имя, почта, телефон" style="min-height:38px;width:280px">
    <button class="btn btn--sm" type="submit">Найти</button>
  </form>
</div>
<nav class="tabs">
  <a href="/admin/orders" class="<%= !status ? 'is-active' : '' %>">Все</a>
  <% Object.entries(ORDER_STATUSES).forEach(([k, st]) => { %>
    <a href="/admin/orders?status=<%= k %>" class="<%= status === k ? 'is-active' : '' %>"><%= st.short %><span><%= counts[k] || 0 %></span></a>
  <% }) %>
</nav>
<% if (!list.length) { %>
  <div class="notice">Здесь пусто.</div>
<% } else { %>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Заказ</th><th>Покупатель</th><th>Город</th><th>Товаров</th><th>Статус</th><th class="num">Сумма</th></tr></thead>
    <tbody>
      <% list.forEach((o) => { const st = ORDER_STATUSES[o.status]; %>
        <tr data-href="/admin/orders/<%= o.id %>">
          <td><a href="/admin/orders/<%= o.id %>"><b><%= o.number %></b></a><div class="muted small"><%= fmt.dateTime(o.created_at) %></div></td>
          <td><%= o.customer_name %><div class="muted small"><%= o.email %> · <%= o.phone %></div></td>
          <td><%= o.city %></td>
          <td><%= o.item_count %></td>
          <td><span class="status status--<%= st.tone %>"><%= st.short %></span></td>
          <td class="num"><b><%= fmt.rub(o.total_rub) %></b></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_footer') %>
