# ---- Выкладка на сервер (только в .env на своём компьютере) ----
# DEPLOY_HOST=root@123.45.67.89
# DEPLOY_KEY=~/.ssh/brandstore_ed25519

# ---- Сайт ----
PORT=3000
NODE_ENV=production
# Адрес сайта без слэша в конце — используется в письмах и для возврата после оплаты
SITE_URL=https://brandstore.ru
# Любая длинная случайная строка (например, результат: openssl rand -hex 32)
SESSION_SECRET=замените-на-случайную-строку

# ---- Администратор (создаётся при первом запуске) ----
ADMIN_EMAIL=admin@brandstore.ru
ADMIN_PASSWORD=смените-этот-пароль

# ---- Почта для уведомлений о заказах ----
# Куда приходят новые заказы (можно поменять в админке → Настройки)
ORDER_NOTIFY_EMAIL=orders@brandstore.ru
# SMTP — например, Яндекс 360: smtp.yandex.ru, порт 465, логин — полный адрес, пароль — пароль приложения
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@brandstore.ru
SMTP_PASS=
MAIL_FROM=Brand Store <no-reply@brandstore.ru>

# ---- Онлайн-оплата ЮKassa (необязательно) ----
# Без ключей менеджер вставляет ссылку на оплату в заказ вручную.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать чеки 54-ФЗ через ЮKassa (нужна подключённая онлайн-касса в ЮKassa)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС для чеков: 1 — без НДС (УСН), см. документацию ЮKassa
YOOKASSA_VAT_CODE=1

# ---- Курс ----
RATES_URL=https://www.cbr-xml-daily.ru/daily_json.js
RATES_REFRESH_HOURS=6

# ---- Автоматическая цена по ссылке ----
# Сайт сам открывает страницу товара и берёт цену. Если сервер в России, часть европейских магазинов
# может не отвечать — тогда укажите прокси в ЕС (лучше в Португалии): http://логин:пароль@адрес:порт
PARSER_PROXY=
PARSER_TIMEOUT_MS=10000
# Встроенный Chrome для сайтов с защитой (Zara, Adidas…): скачать один раз — npm run browser. off — не использовать
PARSER_BROWSER=
PARSER_BROWSER_TIMEOUT_MS=25000
# Если магазин не пускает и встроенный Chrome: msedge — установленный Edge (есть в любом Windows), chrome — Google Chrome.
# Тогда браузером управляет Patchright (не выдаёт автоматизацию)
PARSER_BROWSER_CHANNEL=
# on — с окном за пределами экрана (так проходит Adidas), visible — окно видно. Нужен рабочий стол, на сервере без экрана не работает
PARSER_BROWSER_WINDOW=
